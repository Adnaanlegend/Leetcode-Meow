{
  "manifest_version": 3,
  "name": "LeetCode Cat Celebration",
  "version": "1.0.0",
  "description": "When your code passes on LeetCode, a cat pops out with poppers and a meow.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://leetcode.com/*", "*://www.leetcode.com/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://leetcode.com/*", "*://www.leetcode.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "LeetCode Cat Celebration",
    "default_popup": "popup.html"
  }
}
